NODE_ENV=test
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=test_password
MONGO_INITDB_DATABASE=gopharma_test
MONGODB_URI=mongodb://admin:test_password@mongo-test:27017/gopharma_test?authSource=admin
MONGODB_URI_TEST=mongodb://admin:test_password@mongo-test:27017/gopharma_test?authSource=admin

JWT_ACCESS_SECRET=test_access_secret_key_12345
JWT_REFRESH_SECRET=test_refresh_secret_key_12345
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER=7d

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=test@gopharma.local

GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:3001/auth/google/success
GOOGLE_FAILURE_REDIRECT_URL=http://localhost:3001/auth/google/error
