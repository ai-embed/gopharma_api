{
  "name": "go_pharma_api",
  "version": "0.1.0",
  "description": "GoPharma API (`go_pharma_api`, NestJS + MongoDB)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node src/seeds/seed.ts",
    "seed:test": "node --env-file=.env.test ./node_modules/ts-node/dist/bin.js src/seeds/seed.ts",
    "lint": "eslint -c eslint.config.js \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint -c eslint.config.js \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand --testPathIgnorePatterns=.*\\.mongo\\.integration\\.spec\\.ts$",
    "test:integration": "jest --runInBand --testRegex=.*\\.mongo\\.integration\\.spec\\.ts$",
    "test:env": "node --env-file=.env.test ./node_modules/jest/bin/jest.js --runInBand",
    "test:integration:env": "node --env-file=.env.test ./node_modules/jest/bin/jest.js --runInBand --testRegex=.*\\.mongo\\.integration\\.spec\\.ts$",
    "test:env:cov": "node --env-file=.env.test ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:env": "node --env-file=.env.test ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "start:test": "node --env-file=.env.test ./node_modules/@nestjs/cli/bin/nest.js start --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.4.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.9.0",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.33",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "eslint": "^9.39.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
