FRONTEND_IMAGE=ghcr.io/nxtcv/go-pharma-front:test
API_IMAGE=ghcr.io/nxtcv/go-pharma-api:test

FRONTEND_HOST=test.example.com
API_HOST=api-test.example.com
TRAEFIK_ACME_EMAIL=admin@example.com

NEXT_PUBLIC_API_URL=https://api-test.example.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
CORS_ORIGINS=https://test.example.com

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_DATABASE=gopharma_test

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER=30d

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gopharma.local

GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:3001/auth/google/success
GOOGLE_FAILURE_REDIRECT_URL=http://localhost:3001/auth/google/error

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
